# ===== 必填 =====

# 控制台登录密码
ADMIN_TOKEN=change-me-to-a-strong-password

# 主密钥：32 字节随机值的 base64（44 字符、以 = 结尾）
# 生成（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
# ⚠️ 丢失 = KV 里的令牌全部解不开，只能重新扫码。请存进密码管理器。
MASTER_KEY=

# ===== 可选 =====

# /cron 独立口令（不设则回落用 ADMIN_TOKEN）。建议单独设一个长随机串。
#   openssl rand -hex 24
CRON_SECRET=

# 定时任务，北京时间 cron 表达式，多条用 ; 分隔。
# 这只是「出厂默认」：控制台顶栏「定时」里改过并存盘后，以控制台配置（KV）为准。
# 缺省 "10 8 * * *;20 10 * * *"：08:10 三个平台各跑一遍，10:20 补一轮。
# CRON_SCHEDULES=10 8 * * *;20 10 * * *

# 服务端口（容器内）。已固定为 3009，一般不用动。
# PORT=3009

# ===== 通知（可选，也可以之后在控制台「通知」里配，存 KV）=====
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# QQ_APP_ID=
# QQ_APP_SECRET=
# QQ_OPENID=
# QQ_SANDBOX=

# ===== Qoder 设备通行证（可选）=====
# QODER_MACHINE_TOKEN=
# QODER_MACHINE_CODE=
# QODER_MACHINE_TYPE=
